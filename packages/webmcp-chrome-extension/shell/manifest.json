{
  "manifest_version": 3,
  "name": "webmcp-chrome-extension",
  "description": "Install WebMCP on websites and consume their tools from an isolated content script.",
  "version": "1.1.2",
  "minimum_chrome_version": "116",
  "action": {},
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "permissions": ["sidePanel", "storage", "downloads", "tabs", "scripting"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.iife.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["main-world.iife.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-script.iife.js"],
      "run_at": "document_start"
    }
  ]
}
